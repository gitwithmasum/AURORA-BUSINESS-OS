# Supabase Connection (Required for Auth, PostgreSQL & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Admin Key (NEVER prefix with NEXT_PUBLIC_ or import in client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public App Origin (used for email verification & password reset redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Server-Only AI Provider Keys (leave blank for deterministic grounded insights)
GEMINI_API_KEY=
OPENAI_API_KEY=
